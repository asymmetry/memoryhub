{
  "name": "memoryhub",
  "version": "0.2.0",
  "description": "Deterministic MemoryHub sync for Claude Code (capture + recall hooks)",
  "skills": [{ "name": "mh-config", "path": "skills/mh-config.md" }],
  "hooks": {
    "PostToolBatch": [
      { "hooks": [{ "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/capture.py" }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/recall.py" }] }
    ]
  }
}
